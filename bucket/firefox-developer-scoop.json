{
    "version": "161.0b1",
    "description": "Firefox Developer Edition - a web browser with developer tools by Mozilla",
    "homepage": "https://www.mozilla.org/firefox/developer/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://ftp.mozilla.org/pub/devedition/releases/161.0b1/win64/zh-CN/Firefox%20Setup%20161.0b1.exe#/dl.7z",
            "hash": "9f17b479fa620d8a782b4d8b3ef38463f88f4e25c8952b2a0ceb7b3197a2e515"
        },
        "32bit": {
            "url": "https://ftp.mozilla.org/pub/devedition/releases/161.0b1/win32/zh-CN/Firefox%20Setup%20161.0b1.exe#/dl.7z",
            "hash": "56c78e1df4ff019b28e1173fc34bf80dd7132ee900e0446d563e7edd553ec288"
        },
        "arm64": {
            "url": "https://ftp.mozilla.org/pub/devedition/releases/161.0b1/win64-aarch64/zh-CN/Firefox%20Setup%20161.0b1.exe#/dl.7z",
            "hash": "8b24df4f3c5ff47bb25dc5becb25ff45cef01d53d1d1b1c711d11b41b4728fbc"
        }
    },
    "extract_dir": "core",
    "bin": [
        [
            "firefox.exe",
            "firefox-developer"
        ]
    ],
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox Developer Edition"
        ],
        [
            "firefox.exe",
            "Firefox Developer Edition Profile Manager",
            "-P"
        ]
    ],
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.FIREFOX_DEVEDITION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/win64/zh-CN/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/SHA256SUMS",
                    "regex": "$sha256\\s+win64/zh-CN/$basename"
                }
            },
            "32bit": {
                "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/win32/zh-CN/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/SHA256SUMS",
                    "regex": "$sha256\\s+win32/zh-CN/$basename"
                }
            },
            "arm64": {
                "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/win64-aarch64/zh-CN/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://ftp.mozilla.org/pub/devedition/releases/$version/SHA256SUMS",
                    "regex": "$sha256\\s+win64-aarch64/zh-CN/$basename"
                }
            }
        }
    },
    "post_install": "& \"$bucketsdir\\chenwb-scoop-bucket\\scripts\\Move-FirefoxProfiles.ps1\" -AppDir $dir -PersistDir $persist_dir",
    "notes": [
        "Close all Firefox windows before installing or updating. Profiles for this installation are automatically moved to Scoop persist, keeping junctions at their original paths.",
        "The shared Firefox root and local caches are not moved. An existing Firefox root junction from the old manifest must be restored to a normal directory first."
    ]
}
